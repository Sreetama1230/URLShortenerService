		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.api.url.shortener</groupId>
	<artifactId>URLShortenerService</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>URLShortenerService</name>
	<description>URLShortenerService</description>
	<url/>
